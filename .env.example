# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/votely_dev?schema=public"

# Session cryptographic secret (min 32 characters)
SESSION_SECRET="your-32-character-minimum-random-secret-key"

NODE_ENV="development"

# AfroMessage SMS Configuration
# Provider mode: "afromessage", "production", or "dev"
SMS_PROVIDER="afromessage"
SMS_API_KEY="your-afromessage-bearer-token"
SMS_IDENTIFIER_ID="your-afromessage-identifier-id"
SMS_SENDER_ID="" # optional sender name (must be pre-approved by AfroMessage)
SMS_API_ENDPOINT="https://api.afromessage.com/api/send"
